# —— 依赖与缓存（不入库）——
node_modules/
.py312/
cache/
__pycache__/

# —— 成品与素材（一任务一文件夹，全部本地留存）——
output/

# —— 素材库（本地素材不入库，只进 library/README.md 说明）——
library/*
!library/README.md

